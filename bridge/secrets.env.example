# Copiez ce fichier en secrets.env (ignore par Git) et collez votre cle.
# Cle ElevenLabs : elevenlabs.io > Developers > API Keys,
# permission "Utilisateur" sur "Acces" (user_read). Le reste peut rester sans acces.
ELEVENLABS_API_KEY=sk_votre_cle_ici

# PALais SIAM (optionnel) : notification des nouvelles commandes sur l'ecran.
# URL et cle publique : Supabase > Project Settings > API (la cle "publishable" n'est pas secrete).
# Email et mot de passe : votre compte sur le site (un compte connecte peut lire les commandes).
PALAIS_SIAM_URL=https://xxxxxxxx.supabase.co
PALAIS_SIAM_KEY=sb_publishable_xxx
PALAIS_SIAM_EMAIL=vous@exemple.com
PALAIS_SIAM_PASSWORD=votre_mot_de_passe
