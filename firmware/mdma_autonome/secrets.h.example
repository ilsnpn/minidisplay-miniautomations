// Réglages et secrets de MDMA autonome : tout se règle ici.
// Copiez ce fichier en secrets.h (ignoré par Git) et remplissez-le.
// Une valeur vide ("") désactive la source correspondante.
#pragma once

// Réseaux Wi-Fi (2,4 GHz uniquement), essayés dans cet ordre en mode automatique.
// Réseau ouvert : mot de passe vide "".
// Sur iPhone, activez « Maximiser la compatibilité » dans le partage de connexion.
#define WIFI_NETWORKS \
  { \
    { "MonTelephone", "mot de passe" }, \
    { "MaBox", "mot de passe" }, \
  }

// Fuseau horaire POSIX : Paris, heure d'été comprise
#define TZ_INFO "CET-1CEST,M3.5.0,M10.5.0/3"

// Claude : jeton de renouvellement d'une connexion réservée à la carte.
// 1. Dans un terminal : $env:CLAUDE_CONFIG_DIR = "$env:USERPROFILE\.claude-mdma"
//    puis lancez claude, connectez-vous et quittez avec /exit.
// 2. Copiez ici le champ refreshToken de %USERPROFILE%\.claude-mdma\.credentials.json.
// 3. Ne relancez plus jamais Claude Code avec ce dossier : la connexion appartient à la carte.
// La carte remplace ce jeton à chaque renouvellement et garde le dernier en Flash :
// cette valeur ne sert qu'au premier démarrage, ou quand vous la changez.
#define CLAUDE_REFRESH_TOKEN ""

// ElevenLabs : elevenlabs.io > Developers > API Keys, permission « Utilisateur » sur « Accès »
#define ELEVENLABS_API_KEY ""

// Bourse : ticker Yahoo Finance (AAPL, MSFT, ^GSPC...) ou crypto BTC / ETH / SOL
#define MARKET_SYMBOL "AAPL"
// Cours au choix (appui long sur la vue Bourse), le premier par défaut
#define MARKET_SYMBOLS { "AAPL", "BTC", "ETH" }

// Eau : objectif du jour et taille d'un verre (ml), plage des rappels (heures).
// 1,5 L en verres de 25 cl de 9 h à 19 h : un rappel toutes les 1 h 40, s'il manque un verre.
// WATER_GOAL_ML 0 : pas de rappel.
#define WATER_GOAL_ML 1500
#define WATER_GLASS_ML 250
#define WATER_FROM_H 9
#define WATER_TO_H 19

// PALais SIAM : URL et clé publique (Supabase > Project Settings > API),
// puis votre compte sur le site
#define PALAIS_SIAM_URL ""
#define PALAIS_SIAM_KEY ""
#define PALAIS_SIAM_EMAIL ""
#define PALAIS_SIAM_PASSWORD ""
